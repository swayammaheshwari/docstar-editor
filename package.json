{
  "name": "docstar-editor",
  "version": "0.2.0",
  "description": "A minimal block/markdown editor for React with optional real-time collaboration.",
  "license": "MIT",
  "author": "",
  "keywords": [
    "editor",
    "markdown",
    "blocknote",
    "react",
    "collaboration",
    "yjs"
  ],
  "homepage": "https://swayammaheshwari.github.io/docstar-editor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swayammaheshwari/docstar-editor.git"
  },
  "bugs": {
    "url": "https://github.com/swayammaheshwari/docstar-editor/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@blocknote/core": "^0.42.0",
    "@blocknote/mantine": "^0.42.0",
    "@blocknote/react": "^0.42.0",
    "@hocuspocus/provider": "^2.15.0",
    "@mantine/core": "^8.3.4",
    "react-icons": "^5.2.1",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
